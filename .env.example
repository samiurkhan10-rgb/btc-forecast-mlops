# Copy to .env (never commit .env) and fill in real values.
# Shared secret the Airflow DAG sends in the X-API-Key header to POST /reload
API_KEY=change-me
# Optional: CoinGecko demo/pro key used only by the fallback data source
COINGECKO_API_KEY=
# API settings
LOG_LEVEL=INFO
MODEL_STAGE=production
# Minimum quality gate for promoting a newly trained model (percent)
MAPE_THRESHOLD=10
# Postgres credentials for the Airflow metadata DB (docker compose only)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
# Airflow web UI login (user "admin") and Flask session secret (docker compose only)
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=change-me-too
